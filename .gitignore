# ---- 密钥与环境变量（一律不入库）----
.env
.env.*
!.env.example

# ---- 生成物（保留占位）----
out/*
!out/.gitkeep

# ---- 日志（保留占位）----
data/logs/*.log
data/logs/*.gz
data/logs/*.log.*
data/logs/*.txt
!data/logs/.gitkeep

# ---- 临时文件（课程文档 *.docx 不忽略）----
*.tmp
*.temp
*.swp
*.swo
*.bak
*~
~$*
.DS_Store
Thumbs.db

# ---- 运行期容器数据 ----
data/db/
*.pid

# ---- 课程原始材料（内容已转录进 docs/requirements.md，原件不入库）----
qimo/
