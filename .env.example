# ============================================================
# logops 环境变量模板
#
# 用法：./init.sh 会把本文件复制为 .env，并写入随机生成的 DB_PASSWORD
# 红线：本文件可以入库，.env 绝对不可以（.gitignore 已拦截）
#       任何真实密码、token 都不许写进这里
# ============================================================

# ---- 服务端口 ----
# 宿主端口：80 常被占用，默认 8080；改端口只改这一行
WEB_PORT=8080
# 容器内端口：非 root 进程不能绑定 1024 以下端口，必须 >= 1024
WEB_INNER_PORT=8080

# ---- 容器与镜像 ----
# 服务名：check.sh 用它判断容器是否 running，改这里要同步改脚本里的引用
WEB_SERVICE=web
# 镜像 tag：与 Dockerfile / compose 中的 image 保持一致
IMAGE_TAG=1.0

# ---- 巡检阈值（整数百分比，check.sh 读取）----
DISK_THRESHOLD=80
MEM_THRESHOLD=90

# ---- 容器日志滚动（compose 的 logging.options 读取）----
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ---- 数据库（当前不启用 db 服务，字段保留以符合课程要求 M1）----
# DB_PASSWORD 由 init.sh 生成 16 位随机值后填入；不要手填、不要提交
DB_USER=logops
DB_NAME=logops
DB_PASSWORD=
